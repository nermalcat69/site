---
import { getCollection } from "astro:content";
import Center from "../components/Center.astro";
import PageHeader from "../components/PageHeader.astro";
import Webring from "../components/Webring.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const webrings = await getCollection("webrings");

const title = "Genocides You Should Know About";
const description =
  "This is a list of prominent recognized genocides currently happening around the world.";

const datePublished = new Date("2024-05-16");
const dateModified = new Date("2025-04-21 12:35:00-04:00");
---

<BaseLayout
  title={title}
  description={description}
  includeFooter
  padBottom
  ogImage="/og/webrings.png"
  ogAlt="A collection of old-school gifs."
>
  <PageHeader
    title={title}
    description={description}
    datePublished={datePublished}
    dateModified={dateModified}
  />
  <Center>
    <section>
      <div class="webrings">
        {webrings.map((webring) => <Webring webring={webring} />)}
      </div>
    </section>
  </Center>
</BaseLayout>

<style>
  .webrings {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .badge-section {
    display: flex;
    flex-direction: column;
    row-gap: var(--space-m);
    align-items: center;
    text-align: center;
    padding-block-start: var(--space-3xl);
    padding-inline: var(--space-xs);
    max-width: 1000px;
    margin-inline: auto;
  }

  .badges {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);

    img {
      flex-grow: 0;
      flex-shrink: 0;
      image-rendering: pixelated;
    }
  }

  .credit {
    text-wrap: balance;
  }
</style>
