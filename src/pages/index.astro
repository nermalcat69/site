---

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import WorkList from "src/components/Home/WorkList.astro";
import coffeeImage from "../assets/coffee.png";
import Center from "../components/Center.astro";
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const work = await getCollection("work");
const posts = await getCollection("posts");

const feed = work
  .map((project) => ({
    id: project.id,
    ...project.data,
  }))
  .concat(
    posts.map((post) => ({
      id: `post-${post.id}`,
      title: post.data.title,
      description: post.data.description,
      year: post.data.datePublished.getFullYear(),
      url: `/posts/${post.id}`,
      category: post.data.type === "case-study" ? "case study" : "writing",
      img: post.data.img,
    })),
  )
  .sort((a, b) => b.year - a.year);
---

<BaseLayout
  title="Arjun Aditya | Sustainable Founder of Gray Cup"
  description="Arjun is a designer and programmer based in India."
  includeFooter
>
  <section class="home">
    <Center>
      <h1 class="visuallyhidden">Arjun designs and builds for the web</h1>
      <div class="intro">
        <p class="pb-4">
          <strong><a href="/about">Arjun Aditya</a></strong> is a sustainable programmer / founder engineer who
          likes nature and designing. <br /><br />He Sells Tea, Coffee and Tech Solutions at <a href="https://graycup.org" target="_blank" rel="dofollow">Gray Cup</a>.
        </p>
<a
  href="https://graycup.in/"
  target="_blank"
  rel="dofollow"
  class="nolink"
><button class="orangeshadow dark:bg-white dark:text-black nolink bg-black p-2 text-white inline-block rounded-lg">Visit Online Store</button></a>
      </div>
    </Center>
    <Image src={coffeeImage} draggable="false" loading="eager" alt="Coffee Beans" format="webp" />
  </section>
  <section>

    <Center>
      <h2>Projects</h2>
      <WorkList items={feed} />
    </Center>
  </section>
  <!-- <section>
    <Center>
      <h2>Latest <a href="https://glass.photo/evadecker">photos</a></h2>
    </Center>
    <PhotoFeed server:defer />
  </section> -->
</BaseLayout>

<script>
  import * as Fathom from "fathom-client";
  import { addSam } from "../stores/sam";

  function setupSam() {
    const samButton = document.querySelector("[data-sam-button]");
    samButton?.addEventListener("click", () => addSam());
  }

  setupSam();

  document.addEventListener("astro:after-swap", () => setupSam());

  document.addEventListener("astro:page-load", () => {
    document
      .querySelector("[data-sam-button]")
      ?.addEventListener("click", () => {
        Fathom.trackEvent("stickers: add sam");
      });

    document.querySelector("[data-sam-shoo]")?.addEventListener("click", () => {
      Fathom.trackEvent("stickers: shoo sam");
    });
  });
</script>

<style>
  .visuallyhidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  @keyframes rotate {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  .intro {
    padding-block: var(--space-2xl);
    text-wrap: balance;

    p {
      font-size: var(--step-4);
      letter-spacing: var(--letter-spacing-condensed);
      line-height: var(--line-height-tight);
    }

    a {
      background: unset;
      border: unset;
      margin: unset;
      line-height: unset;
      display: unset;
      padding: unset;
      cursor: pointer;
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--gray-8);
      text-underline-offset: max(0.1em, 2.5px);
      transition:
        text-decoration-color 0.2s ease-in-out,
        font-weight 0.2s ease-in-out;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          font-weight: var(--font-weight-bold);
          text-decoration-color: var(--gray-11);
        }
      }
    }
  }

  [data-sam-button] {
    cursor: pointer;

    &:active {
      transform: scale(0.95);
    }
  }

  section {
    width: 100%;
    padding-block-end: var(--space-3xl);
  }

  h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-m);
  }
  
</style>
